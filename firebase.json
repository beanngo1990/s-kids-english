{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      ".git",
      ".gitignore",
      ".env*",
      ".secret.local",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "lib/__tests__",
      "node_modules",
      "scripts",
      "src",
      "*.local"
    ],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": false
    }
  },
  "react-native": {
    "analytics_auto_collection_enabled": false,
    "analytics_collection_deactivated": true,
    "analytics_default_allow_ad_personalization_signals": false,
    "analytics_default_allow_ad_storage": false,
    "analytics_default_allow_ad_user_data": false,
    "analytics_default_allow_analytics_storage": false,
    "analytics_idfv_collection_enabled": false,
    "app_data_collection_default_enabled": false,
    "google_analytics_registration_with_ad_network_enabled": false,
    "in_app_messaging_auto_collection_enabled": false,
    "messaging_auto_init_enabled": false,
    "perf_auto_collection_enabled": false,
    "perf_collection_deactivated": true
  }
}
